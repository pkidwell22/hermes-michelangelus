@@ -0,0 +1,186 @@
+import type { ModelCapabilities } from '@hermes/shared'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { ComposerControls } from '@/app/chat/composer/controls'
+import { I18nProvider } from '@/i18n'
+import {
+  $activeSessionId,
+  $currentModel,
+  $currentProvider,
+  setCurrentFastMode,
+  setCurrentServiceTier
+} from '@/store/session'
+
+import { ReasoningMenuPanel } from './reasoning-menu-panel'
+
+const model = 'speed-test-model'
+const provider = 'speed-test-provider'
+
+beforeEach(() => {
+  $activeSessionId.set('speed-test-runtime')
+  $currentModel.set(model)
+  $currentProvider.set(provider)
+  setCurrentFastMode(false)
+  setCurrentServiceTier('normal')
+})
+
+afterEach(cleanup)
+
+function mountSpeed(capabilities: ModelCapabilities, models = [model], disabled = false) {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+
+  const requestGateway = vi.fn(async (method: string) => {
+    if (method === 'model.options') {
+      return { providers: [{ slug: provider, models, capabilities: { [model]: capabilities } }] }
+    }
+
+    if (method === 'config.set') {
+      return { status: 'ok' }
+    }
+    throw new Error(`Unexpected request: ${method}`)
+  })
+
+  const onSelectModel = vi.fn()
+  const noop = () => undefined
+  render(
+    <I18nProvider configClient={null} initialLocale="en">
+      <QueryClientProvider client={queryClient}>
+        <ComposerControls
+          autoSpeak={false}
+          busy={false}
+          busyAction="stop"
+          canSubmit={false}
+          conversation={{
+            active: false,
+            level: 0,
+            muted: false,
+            onEnd: noop,
+            onStart: noop,
+            onStopTurn: noop,
+            onToggleMute: noop,
+            status: 'idle'
+          }}
+          disabled={disabled}
+          hasComposerPayload={false}
+          onDictate={noop}
+          onQueue={noop}
+          onToggleAutoSpeak={noop}
+          state={{
+            model: {
+              canSwitch: true,
+              model,
+              provider,
+              renderSpeedPill: speedDisabled => (
+                <ReasoningMenuPanel
+                  onSelectModel={onSelectModel}
+                  requestGateway={requestGateway as never}
+                  speedDisabled={speedDisabled}
+                />
+              )
+            },
+            tools: { enabled: true, label: 'Add context' },
+            voice: { active: false, enabled: true }
+          }}
+          voiceStatus="idle"
+        />
+      </QueryClientProvider>
+    </I18nProvider>
+  )
+
+  return { onSelectModel, requestGateway }
+}
+
+async function openSpeed(name: string) {
+  const button = await screen.findByRole('button', { name })
+  fireEvent.keyDown(button, { key: 'Enter' })
+
+  return screen.findByRole('menu')
+}
+
+it('toggles the owning session between Standard and Fast without changing reasoning', async () => {
+  const { requestGateway, onSelectModel } = mountSpeed({ fast: true, reasoning: false })
+  await openSpeed('Speed: Standard')
+  expect(screen.getByRole('menuitemradio', { name: 'Standard' }).getAttribute('aria-checked')).toBe('true')
+  expect(screen.queryByRole('menuitemradio', { name: 'Ultrafast' })).toBeNull()
+  fireEvent.click(screen.getByRole('menuitemradio', { name: 'Fast' }))
+  await waitFor(() =>
+    expect(requestGateway).toHaveBeenCalledWith('config.set', {
+      key: 'fast',
+      session_id: 'speed-test-runtime',
+      value: 'fast'
+    })
+  )
+  await openSpeed('Speed: Fast')
+  expect(screen.getByRole('menuitemradio', { name: 'Fast' }).getAttribute('aria-checked')).toBe('true')
+  fireEvent.click(screen.getByRole('menuitemradio', { name: 'Standard' }))
+  await waitFor(() =>
+    expect(requestGateway).toHaveBeenCalledWith('config.set', {
+      key: 'fast',
+      session_id: 'speed-test-runtime',
+      value: 'normal'
+    })
+  )
+  expect(requestGateway.mock.calls.filter(([method]) => method === 'config.set')).toHaveLength(2)
+  expect(onSelectModel).not.toHaveBeenCalled()
+})
+
+it('hides the pill when the route does not offer speed', async () => {
+  const { requestGateway } = mountSpeed({ fast: false, reasoning: true })
+  await act(async () => {
+    await requestGateway.mock.results[0].value
+  })
+  expect(screen.queryByTestId('speed-pill')).toBeNull()
+})
+
+it('does not show Fast on an Ultrafast-only route', async () => {
+  setCurrentFastMode(true)
+  setCurrentServiceTier('ultrafast')
+  mountSpeed({ fast: false, ultrafast: true, reasoning: true })
+  await openSpeed('Speed: Ultrafast')
+  expect(screen.getByRole('menuitemradio', { name: 'Ultrafast' }).getAttribute('aria-checked')).toBe('true')
+  expect(screen.queryByRole('menuitemradio', { name: 'Fast' })).toBeNull()
+})
+
+it('requests Ultrafast rather than ordinary Fast for the current session', async () => {
+  const { requestGateway, onSelectModel } = mountSpeed({ fast: true, ultrafast: true, reasoning: true })
+  await openSpeed('Speed: Standard')
+  fireEvent.click(screen.getByRole('menuitemradio', { name: 'Ultrafast' }))
+  await waitFor(() =>
+    expect(requestGateway).toHaveBeenCalledWith('config.set', {
+      key: 'fast',
+      session_id: 'speed-test-runtime',
+      value: 'ultrafast'
+    })
+  )
+  await openSpeed('Speed: Ultrafast')
+  expect(screen.getByRole('menuitemradio', { name: 'Ultrafast' }).getAttribute('aria-checked')).toBe('true')
+  expect(requestGateway.mock.calls.filter(([method]) => method === 'config.set')).toHaveLength(1)
+  expect(onSelectModel).not.toHaveBeenCalled()
+})
+
+it('does not label a fast-only route Ultrafast when the prior model supported it', async () => {
+  setCurrentFastMode(true)
+  setCurrentServiceTier('ultrafast')
+  mountSpeed({ fast: true, reasoning: true })
+  await openSpeed('Speed: Standard')
+  expect(screen.getByRole('menuitemradio', { name: 'Standard' }).getAttribute('aria-checked')).toBe('true')
+  expect(screen.queryByRole('menuitemradio', { name: 'Ultrafast' })).toBeNull()
+})
+
+it('uses the native model switch when Fast is a distinct variant', async () => {
+  const { onSelectModel } = mountSpeed({ fast: false, reasoning: true }, [model, `${model}-fast`])
+  await openSpeed('Speed: Standard')
+  fireEvent.click(screen.getByRole('menuitemradio', { name: 'Fast' }))
+  expect(onSelectModel).toHaveBeenCalledWith({ model: `${model}-fast`, provider, sessionId: 'speed-test-runtime' })
+})
+
